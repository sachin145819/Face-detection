# =============================================================================
# TruthLens — environment configuration
#   cp .env.example .env
# Docker Compose reads this file automatically. For local (non-Docker) dev the
# backend reads the same variable names (see docs/CONTRACT.md §2); anything left
# unset falls back to the local-dev defaults noted below.
# =============================================================================

# ---------- Security ----------
# JWT signing key. MUST be changed for any shared/public deployment:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me
# Access-token lifetime in minutes (1440 = 24 h).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- Database ----------
# Used by the `db` service in docker-compose. Avoid URL-special characters
# (@ : / ? #) in the password, or URL-encode them in DATABASE_URL.
POSTGRES_USER=truthlens
POSTGRES_PASSWORD=truthlens
POSTGRES_DB=truthlens
# Host port for docker-compose.dev.yml (Postgres-only dev stack).
POSTGRES_PORT=5432

# Local dev default is SQLite (no setup needed). Compose ignores this value and
# builds the URL from POSTGRES_* pointing at the `db` service.
#   SQLite   : sqlite:///./truthlens.db
#   Postgres : postgresql+psycopg://truthlens:truthlens@localhost:5432/truthlens
DATABASE_URL=sqlite:///./truthlens.db

# ---------- Storage ----------
# Uploaded images, heatmaps, restorations and PDF reports.
# (Compose forces /app/storage on a named volume.)
STORAGE_DIR=./storage
# Max upload size in MB (nginx allows 12 MB bodies to leave multipart headroom).
MAX_UPLOAD_MB=10
# Max video upload size in MB (keep nginx client_max_body_size above this).
MAX_VIDEO_MB=100
# Frames sampled evenly across each video for analysis (more = slower, finer timeline).
VIDEO_MAX_FRAMES=16

# ---------- CORS ----------
# Comma-separated browser origins allowed to call the API directly.
# Through nginx / the Vite proxy the calls are same-origin, so this mostly matters
# for split deployments (e.g. https://truthlens.vercel.app).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- ML pipeline ----------
# true  -> deep models (deepfake + AI-generated detectors, PyTorch/Hugging Face)
# false -> classical forensics only (metadata, ELA, noise, frequency): fast, no torch
ML_ENABLE_DEEP=true
# Hugging Face / torch weights cache. (Compose forces /app/models_cache on a volume.)
MODEL_CACHE_DIR=./models_cache
# Docker build: bake model weights into the backend image (true/false).
PRELOAD_MODELS=true

# ---------- Server ----------
# Uvicorn worker processes. Each worker loads its own copy of the ML models
# (~1-2 GB RAM each), so keep 1 unless the host has plenty of memory.
UVICORN_WORKERS=1
# Run `alembic upgrade head` on container start.
RUN_MIGRATIONS=true

# ---------- Published ports (docker compose) ----------
FRONTEND_PORT=8080
BACKEND_PORT=8000
